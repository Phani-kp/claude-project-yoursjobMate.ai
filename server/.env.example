# Copy to server/.env for local development, or set these in your host's environment settings.
# Settings marked REQUIRED IN PRODUCTION stop the server from starting when NODE_ENV=production and they're missing.

PORT=4000
# NODE_ENV=production

# ---- Database (where every user's account and profile is saved) ----
# REQUIRED IN PRODUCTION. A PostgreSQL connection string from your cloud provider, for example:
#   Neon      postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#   Supabase  postgresql://postgres.xxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
#   Render, Railway, AWS RDS, Google Cloud SQL and Azure all give you one too.
# Leave it empty for local development: an embedded Postgres is stored in server/data/pgdata.
DATABASE_URL=
# DB_POOL_SIZE=5                    # keep small on Supabase: its free session pooler allows 15 connections in total

# ---- Security ----
# REQUIRED IN PRODUCTION. Signs login sessions and email codes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
# REQUIRED IN PRODUCTION. Secret key mixed into every password before it is hashed. It is never stored in the
# database, so a stolen database alone can't be used to crack passwords. Generate it the same way as JWT_SECRET.
# NEVER change it after users sign up (their passwords would stop working). Keep a backup in a password manager.
PASSWORD_PEPPER=change-me-to-another-long-random-string
# Set to 1 when running behind a proxy or load balancer (Render, Railway, Fly, Nginx, Cloudflare…).
# TRUST_PROXY=1
# Only needed if the frontend is hosted on a different domain from the API (comma-separated).
# CORS_ORIGIN=https://app.example.com

# ---- Email (sign-up verification and password reset codes) ----
# REQUIRED IN PRODUCTION: SMTP_HOST. Without it (in development) codes are printed in the server terminal.
# Use a transactional email provider for real users, for example:
#   Resend    SMTP_HOST=smtp.resend.com             SMTP_USER=resend   SMTP_PASS=<API key>
#   Brevo     SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587   SMTP_USER=<login>  SMTP_PASS=<SMTP key>
#   SendGrid  SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587      SMTP_USER=apikey   SMTP_PASS=<API key>
#   AWS SES   SMTP_HOST=email-smtp.<region>.amazonaws.com    SMTP_USER/PASS=<SMTP credentials>
#   Gmail     SMTP_HOST=smtp.gmail.com  SMTP_USER=<you@gmail.com>  SMTP_PASS=<App Password>  (testing only)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown to users. Must be an address on a domain you've verified with your provider.
# MAIL_FROM="YoursJobMate <no-reply@yourdomain.com>"
# APP_NAME=YoursJobMate

# ---- Job sources ----
# Always on, no key needed: ~270 company career sites (Greenhouse, Lever, Ashby, Workday, SmartRecruiters: see
# src/companies.js), Amazon's own job site, plus Remote OK, Remotive and The Muse. Users can add any other company from
# the app. Only US jobs posted in the last JOB_MAX_AGE_DAYS days are kept.
# JOB_MAX_AGE_DAYS=30
# SYNC_EVERY_MS=3600000              # in-app refresh interval (default hourly). Set 0 when the GitHub Action syncs instead.
# WORKDAY_MAX_JOBS=500               # newest jobs kept per Workday employer (retailers list thousands of store jobs)
# AMAZON_MAX_JOBS=3000
# Add more company boards without code changes (ats:token:Display Name, comma-separated):
# EXTRA_COMPANY_BOARDS=greenhouse:acme:Acme Inc,lever:globex:Globex
#
# Optional extra sources, each switched on by its free key:
# Adzuna: millions of US postings from thousands of job boards. Free key: https://developer.adzuna.com/signup
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# USAJOBS: official US federal government jobs. Free key: https://developer.usajobs.gov/apirequest/
# USAJOBS_API_KEY=
# USAJOBS_EMAIL=you@example.com      # the email you requested the key with
# JSearch: Google for Jobs, which covers LinkedIn, Indeed, Glassdoor and ZipRecruiter. Key on RapidAPI (free tier):
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# JSEARCH_API_KEY=

# ---- Rate limits (requests per IP) ----
# Sign-up, login and code requests per 15 minutes (default 10; verify/reset 30).
# AUTH_RATE_LIMIT=10
# All API requests per minute (default 300).
# API_RATE_LIMIT=300

# ---- AI and auto-apply ----
# Enables AI-tailored cover letters with Claude. Without it a template is used.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# How often the auto-apply agent runs (ms)
AGENT_INTERVAL_MS=60000
# simulate = record applications without contacting employers (see README)
APPLY_MODE=simulate
