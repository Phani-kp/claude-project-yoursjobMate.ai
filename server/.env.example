# Copy to server/.env for local development, or set these in your host's server runtime environment settings.
# Never put server secrets in client/.env, VITE_* variables, browser code, or Docker build arguments.
# .env and .env.* secret variants are ignored by Git and excluded from Docker builds; .env.example stays tracked.
# Settings marked REQUIRED IN PRODUCTION stop the server from starting when NODE_ENV=production and they're missing.

PORT=4000
# NODE_ENV=production

# ---- Database (where every user's account and profile is saved) ----
# REQUIRED IN PRODUCTION. Use a persistent hosted PostgreSQL database shared by all deployed app instances, for example:
#   Neon      postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#   Supabase  postgresql://postgres.xxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
#   Render, Railway, AWS RDS, Google Cloud SQL and Azure all give you one too.
# Follow your provider's TLS/CA instructions. Cloud connections verify certificates by default unless URL TLS
# options are supplied; sslmode/sslrootcert/sslcert/sslkey in the URL take precedence. Do not globally disable
# certificate verification to fix a CA error; use the provider's supported settings and certificate files.
# Leave it empty for local development: an embedded Postgres is stored in server/data/pgdata.
# Or run Postgres 17 locally with `docker compose up -d --wait` (see docker-compose.yml) and use:
#   DATABASE_URL=postgresql://yoursjobmate:yoursjobmate@localhost:5432/yoursjobmate
DATABASE_URL=
# Optional PGlite directory when DATABASE_URL is empty; relative paths resolve from server/, independent of cwd.
# DB_PATH=data/pgdata
# Run one API/watch process per directory. Stop it cleanly before another process opens the same database.
# On a startup/checkpoint error, preserve the original and an untouched backup; never delete pgdata or reset it.
# Recover only on disposable copies, validate account/profile data, and keep the same PASSWORD_PEPPER.
# DB_POOL_SIZE=5                    # keep small on Supabase: its free session pooler allows 15 connections in total

# ---- Security ----
# REQUIRED IN PRODUCTION. At least 32 random characters; known placeholder patterns such as change-me are rejected.
# Signs login sessions and email codes. Generate an independent value for each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep it stable across deploys and instances; changing it signs everyone out and invalidates pending codes.
JWT_SECRET=
# REQUIRED IN PRODUCTION. Secret key mixed into every password before it is hashed. It is never stored in the
# database, so a stolen database alone can't be used to crack passwords. Generate it the same way as JWT_SECRET.
# Must be at least 32 random characters, different from JWT_SECRET; known placeholder patterns are rejected.
# NEVER change it after users sign up (their passwords would stop working). Keep a backup in a password manager.
PASSWORD_PEPPER=
# Set TRUST_PROXY to your host's documented proxy hop count or trusted proxy IP/subnet list; 1 is correct only
# for exactly one trusted proxy. Leave empty for a direct connection. Do not guess or blindly trust all proxies.
# Proxies must overwrite forwarded headers; verify the topology with your host's documentation.
TRUST_PROXY=
# Optional exact browser origins (comma-separated, no paths); leave empty for the built frontend served by Express.
# The bundled frontend uses same-origin /api and /socket.io. A separately hosted frontend must proxy those paths
# to this server; CORS_ORIGIN alone does not change its API URL.
# CORS_ORIGIN=https://app.example.com

# ---- Email (sign-up verification and password reset codes) ----
# REQUIRED IN PRODUCTION: BREVO_API_KEY or SMTP_HOST. With neither (in development) codes are printed in the server
# terminal. If both are set, Brevo is used. The server log shows the active mode at startup: "[mail] Mode: ...".
#
# ---- Brevo setup (HTTP API) ----
# No personal Gmail address or mailbox password is needed; MAIL_FROM can be a project/business sender you control.
#   1. Create a free account at https://www.brevo.com
#   2. Settings -> Senders, Domains, IPs -> Senders -> Add a sender. Verify a single email address you control
#      using the code Brevo emails to it. See https://help.brevo.com/hc/en-us/articles/208836149
#   3. SMTP & API -> API Keys -> Generate a new API key. Copy it once; Brevo won't show it again.
#      Grant Transactional email: All for sending and scoped checks. Account: Read is not required by the app.
#   4. Paste it below and set MAIL_FROM to the sender you verified in step 2, then restart the server.
#   5. For 401 "unrecognised IP address", open https://app.brevo.com/security/authorised_ips as account owner,
#      choose Authorize IP addresses, add the trusted public outbound IPv4/IPv6 Brevo reports, and confirm.
#      Keep IP security enabled; local/VPN IPs can change. Authorize the production host's outbound IPs separately.
#   6. From the repo root run: npm --prefix server run mail:check
#      Uses scoped API read + sandbox drop request: no email sent or Brevo email log created. Validates API access
#      and request format only; it does not verify the sender or inbox delivery. Then test real sign-up/reset.
# For 403 permission errors, update the configured key to Transactional email: All; IP authorization is separate.
# For production, authenticate your business sending domain in Brevo and add exactly the DNS records Brevo supplies
# at your DNS provider (Brevo verification, DKIM, DMARC, and any other records it requires). Wait until verified.
# Ensure transactional sending is enabled for the Brevo account; use Transactional -> Logs to inspect delivery.
BREVO_API_KEY=
# Sender shared by Brevo and SMTP; use an address verified with your provider, for example:
#   YoursJobMate <no-reply@your-business-domain.example>
# One app-owned sender sends to every user's dynamically supplied email; recipients are not sender addresses.
MAIL_FROM=
# User account data stays in our Postgres; Brevo receives the sender, recipient and email contents for delivery.
#
# Alternative: any SMTP server. Leave BREVO_API_KEY empty to use SMTP, for example:
#   Resend    SMTP_HOST=smtp.resend.com             SMTP_USER=resend   SMTP_PASS=<API key>
#   Brevo     SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587   SMTP_USER=<login>  SMTP_PASS=<SMTP key>
#   SendGrid  SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587      SMTP_USER=apikey   SMTP_PASS=<API key>
#   AWS SES   SMTP_HOST=email-smtp.<region>.amazonaws.com    SMTP_USER/PASS=<SMTP credentials>
#   Gmail     SMTP_HOST=smtp.gmail.com  SMTP_USER=<you@gmail.com>  SMTP_PASS=<App Password>  (testing only)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# APP_NAME=YoursJobMate

# ---- Job sources ----
# Always on, no key needed: ~270 company career sites (Greenhouse, Lever, Ashby, Workday, SmartRecruiters: see
# src/companies.js), Amazon's own job site, plus Remote OK, Remotive and The Muse. Users can add any other company from
# the app. Only US jobs posted in the last JOB_MAX_AGE_DAYS days are kept.
# JOB_MAX_AGE_DAYS=30
# SYNC_EVERY_MS=900000               # in-app refresh interval (default every 15 minutes). Set 0 when the GitHub Action syncs instead.
# SYNC_CONCURRENCY=16                # how many sources are fetched at once
# API_SYNC_EVERY_MS=21600000         # Adzuna, USAJOBS and JSearch refresh this often (default 6 hours): their free plans cap requests
# WORKDAY_MAX_JOBS=500               # newest jobs kept per Workday employer (retailers list thousands of store jobs)
# AMAZON_MAX_JOBS=3000
# Add more company boards without code changes (ats:token:Display Name, comma-separated):
# EXTRA_COMPANY_BOARDS=greenhouse:acme:Acme Inc,lever:globex:Globex
#
# Optional extra sources, each switched on by its free key:
# Adzuna: millions of US postings from thousands of job boards. Free key: https://developer.adzuna.com/signup
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# USAJOBS: official US federal government jobs. Free key: https://developer.usajobs.gov/apirequest/
# USAJOBS_API_KEY=
# USAJOBS_EMAIL=you@example.com      # the email you requested the key with
# JSearch: Google for Jobs, which covers LinkedIn, Indeed, Glassdoor and ZipRecruiter. Key on RapidAPI (free tier):
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# JSEARCH_API_KEY=

# ---- Rate limits (requests per IP) ----
# Sign-up, login and code requests per 15 minutes (default 10; verify/reset 30).
# AUTH_RATE_LIMIT=10
# All API requests per minute (default 300).
# API_RATE_LIMIT=300

# ---- AI and auto-apply ----
# Enables AI resume tailoring (bullets rewritten in the job's wording, skills matched from your real experience) and
# AI cover letters with Claude. Without it resumes are only reordered by built-in rules and cover letters use a template.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# How often the auto-apply agent runs (ms)
AGENT_INTERVAL_MS=60000
# simulate = record applications without contacting employers (see README)
APPLY_MODE=simulate
